{
  "name": "affetta-standalone",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "description": "Affetta — slicer FDM standalone con viewer 3D, account verificati, profili costi personali e API provider-agnostic.",
  "scripts": {
    "init": "node scripts/init.mjs",
    "start": "node bootstrap.js",
    "dev": "AFFETTA_ALLOW_DEMO_GCODE=true node --watch bootstrap.js",
    "doctor": "node scripts/doctor.mjs",
    "test": "node scripts/run-tests.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:engines": "node scripts/engine-selftest.mjs",
    "test:profiles": "node scripts/profile-asset-selftest.mjs",
    "test:fleet": "node scripts/fleet-profile-selftest.mjs",
    "test:fleet-live": "node scripts/lab-fleet-live-selftest.mjs",
    "test:contracts": "node --test test/contracts/job-contract.test.js",
    "agent:build": "npm --prefix agent run build",
    "agent:test": "npm --prefix agent test",
    "agent:e2e": "npm --prefix agent run test:e2e",
    "backend:build": "npm --prefix backend run build",
    "backend:test": "npm --prefix backend test",
    "backend:start": "npm --prefix backend start",
    "backend:migrate": "npm --prefix backend run migrate",
    "agent:p3.3:test": "npm --prefix agent run test:p3.3",
    "agent:p3.3:live": "npm --prefix agent run live:p3.3",
    "backend:p4.1:live": "npm --prefix backend run live:p4.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
