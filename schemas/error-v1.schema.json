{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.affetta.dev/error-v1.schema.json",
  "title": "Affetta structured error v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message",
    "stage",
    "retryable",
    "details",
    "correlation_id"
  ],
  "properties": {
    "code": {
      "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/errorCode"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "stage": {
      "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/jobStage"
    },
    "retryable": {
      "type": "boolean"
    },
    "details": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": true
    },
    "observed": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": true
    },
    "correlation_id": {
      "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/typedId"
    }
  }
}
