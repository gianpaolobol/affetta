{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.affetta.dev/job-result-v1.schema.json",
  "title": "Affetta normalized job result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "request_id",
    "idempotency_key",
    "status",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "affetta.result.v1"
    },
    "job_id": {
      "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/typedId"
    },
    "request_id": {
      "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/typedId"
    },
    "idempotency_key": {
      "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/idempotencyKey"
    },
    "status": {
      "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/jobStatus"
    },
    "updated_at": {
      "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/timestamp"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "printer_profile_id",
        "printer_profile_version",
        "printer_profile_sha256",
        "engine",
        "output_format",
        "time_seconds",
        "validation",
        "artifacts"
      ],
      "properties": {
        "printer_profile_id": {
          "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/slug"
        },
        "printer_profile_version": {
          "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/semver"
        },
        "printer_profile_sha256": {
          "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/sha256"
        },
        "profile_status": {
          "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/profileStatus"
        },
        "fleet_unit_id": {
          "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/slug"
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/engineId"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "postprocessors": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/postprocessorId"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        },
        "output_format": {
          "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/outputFormat"
        },
        "time_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        },
        "filament": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grams",
            "millimeters"
          ],
          "properties": {
            "grams": {
              "type": "number",
              "minimum": 0
            },
            "millimeters": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "valid",
            "warnings",
            "observed"
          ],
          "properties": {
            "valid": {
              "type": "boolean"
            },
            "warnings": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "observed": {
              "type": "object",
              "maxProperties": 200,
              "additionalProperties": true
            }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/artifact"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "output_format": {
                "const": "gcode"
              }
            },
            "required": [
              "output_format"
            ]
          },
          "then": {
            "properties": {
              "artifacts": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "gcode"
                    },
                    "format": {
                      "const": "gcode"
                    }
                  },
                  "required": [
                    "type",
                    "format"
                  ]
                },
                "type": "array"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "output_format": {
                "const": "x3g"
              }
            },
            "required": [
              "output_format"
            ]
          },
          "then": {
            "properties": {
              "artifacts": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "x3g"
                    },
                    "format": {
                      "const": "x3g"
                    }
                  },
                  "required": [
                    "type",
                    "format"
                  ]
                },
                "type": "array"
              },
              "postprocessors": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "const": "gpx"
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "type": "array"
              }
            },
            "required": [
              "postprocessors"
            ]
          }
        }
      ]
    },
    "error": {
      "$ref": "https://schemas.affetta.dev/error-v1.schema.json"
    },
    "extensions": {
      "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "result": true,
          "error": false
        },
        "required": [
          "result"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "error": true,
          "result": false
        },
        "required": [
          "error"
        ]
      }
    }
  ]
}
