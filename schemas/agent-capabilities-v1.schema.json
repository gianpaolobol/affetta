{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.affetta.dev/agent-capabilities-v1.schema.json",
  "title": "Affetta Agent capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_id",
    "observed_at",
    "status",
    "affetta_version",
    "protocol_versions",
    "active_jobs",
    "disk_free_bytes",
    "platform",
    "engines",
    "postprocessors",
    "output_formats",
    "printer_profiles",
    "capability_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "affetta.agent-capabilities.v1"
    },
    "agent_id": {
      "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/typedId"
    },
    "observed_at": {
      "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/timestamp"
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "degraded",
        "offline",
        "revoked"
      ]
    },
    "affetta_version": {
      "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/semver"
    },
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "affetta.job.v1",
          "affetta.result.v1",
          "affetta.event.v1"
        ]
      }
    },
    "active_jobs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "disk_free_bytes": {
      "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/byteCount"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "arch",
        "node_version"
      ],
      "properties": {
        "os": {
          "type": "string",
          "enum": [
            "windows",
            "linux",
            "macos"
          ]
        },
        "arch": {
          "type": "string",
          "enum": [
            "x64",
            "arm64"
          ]
        },
        "node_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "hostname_hash": {
          "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "engines": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "available"
        ],
        "properties": {
          "id": {
            "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/engineId"
          },
          "available": {
            "type": "boolean"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "diagnostic": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "postprocessors": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "available"
        ],
        "properties": {
          "id": {
            "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/postprocessorId"
          },
          "available": {
            "type": "boolean"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "diagnostic": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "output_formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/outputFormat"
      }
    },
    "printer_profiles": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "profile_version",
          "profile_sha256",
          "profile_status",
          "output_format",
          "materials",
          "nozzles_mm",
          "production_ready",
          "physical_validation"
        ],
        "properties": {
          "profile_id": {
            "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/slug"
          },
          "profile_version": {
            "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/semver"
          },
          "profile_sha256": {
            "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/sha256"
          },
          "profile_status": {
            "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/profileStatus"
          },
          "output_format": {
            "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/outputFormat"
          },
          "materials": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/slug"
            }
          },
          "nozzles_mm": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3
            }
          },
          "production_ready": {
            "type": "boolean"
          },
          "physical_validation": {
            "type": "string",
            "enum": [
              "pending",
              "passed",
              "failed",
              "not_required"
            ]
          }
        }
      }
    },
    "capability_sha256": {
      "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/sha256"
    },
    "extensions": {
      "$ref": "https://schemas.affetta.dev/common-v1.schema.json#/$defs/extensions"
    }
  }
}
