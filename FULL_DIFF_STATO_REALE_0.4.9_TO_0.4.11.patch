diff -ruN '--exclude=.env' '--exclude=data' '--exclude=runtime' '--exclude=node_modules' '--exclude=REPORT_FIXTURE_*.json' '--exclude=REPORT_FIXTURE_*.log' '--exclude=FULL_DIFF_STATO_REALE_0.4.9_TO_0.4.11.patch' '--exclude=MANIFEST_SHA256.txt' /mnt/data/affetta-real-state2/src/runtime-diagnostics.js /mnt/data/affetta-v0.4.11-real-state/src/runtime-diagnostics.js
--- /mnt/data/affetta-real-state2/src/runtime-diagnostics.js	1970-01-01 00:00:00.000000000 +0000
