# Backend cloud Affetta. HTTPS obbligatorio fuori dai test locali.
AFFETTA_CLOUD_BASE_URL=https://api.affetta.example
AFFETTA_PAIRING_CODE=
AFFETTA_AGENT_NAME=Bologna Lab 01

# Affetta standalone sullo stesso computer. Deve restare loopback.
AFFETTA_LOCAL_BASE_URL=http://127.0.0.1:8787
AFFETTA_LOCAL_API_KEY=

# Stato locale separato dal repository.
AFFETTA_AGENT_DATA_DIR=C:\AFFETTA_AGENT\agent-data

# Host ammessi per download/upload firmati, separati da virgola.
# Includere il dominio dello storage S3 compatibile usato dal backend.
AFFETTA_ARTIFACT_ALLOWED_HOSTS=api.affetta.example,storage.affetta.example

AFFETTA_AGENT_POLL_MS=5000
AFFETTA_AGENT_HEARTBEAT_MS=30000
AFFETTA_AGENT_LEASE_RENEW_MS=15000
AFFETTA_HTTP_TIMEOUT_MS=30000
AFFETTA_LOCAL_JOB_TIMEOUT_MS=3600000
AFFETTA_MAX_DOWNLOAD_MB=25

# Solo test/sviluppo locale. Non abilitare in produzione.
AFFETTA_AGENT_ALLOW_INSECURE_HTTP=false
