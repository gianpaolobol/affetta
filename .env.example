# Affetta Standalone v0.4.12
AFFETTA_HOST=0.0.0.0
AFFETTA_PORT=8787
AFFETTA_PUBLIC_BASE_URL=http://127.0.0.1:8787
AFFETTA_PUBLIC_MODE=true
AFFETTA_MAX_FILE_MB=25
AFFETTA_ALLOW_GEOMETRY_FALLBACK=true
AFFETTA_ALLOW_DEMO_GCODE=false
AFFETTA_EXPOSE_ENGINE_NAMES=false
AFFETTA_ARTIFACT_TTL_HOURS=72
AFFETTA_SESSION_DAYS=30
AFFETTA_EMAIL_VERIFICATION_HOURS=24

# In locale lascia log: la mail viene salvata in data/mail-outbox.
# In produzione usa smtp e configura i campi sottostanti.
AFFETTA_MAIL_MODE=log
AFFETTA_MAIL_FROM=Affetta <noreply@example.com>
AFFETTA_SMTP_HOST=
AFFETTA_SMTP_PORT=587
AFFETTA_SMTP_SECURE=false
AFFETTA_SMTP_USER=
AFFETTA_SMTP_PASS=
AFFETTA_SMTP_HELO=affetta.example

# API future per Stampa3DBologna e Reborn
AFFETTA_API_KEYS=stampa3dbologna:CAMBIA_QUESTA_CHIAVE,reborn:CAMBIA_QUESTA_CHIAVE
AFFETTA_ADMIN_TOKEN=CAMBIA_QUESTO_TOKEN
AFFETTA_ALLOWED_ORIGINS=

# Motori
KIRI_CLI_COMMAND=
PRUSA_SLICER_BIN=
CURA_ENGINE_BIN=
ORCA_SLICER_BIN=
AFFETTA_CURA_DEFINITIONS_DIR=
AFFETTA_ORCA_PROFILES_DIR=
AFFETTA_INSTANCE_ID=
AFFETTA_BUILD_ID=
SNAPMAKER_ORCA_BIN=
